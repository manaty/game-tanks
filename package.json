{
  "name": "@manaty/game-tanks",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Play Tanks · Ricochets together on a shared screen, using phones as controllers. 2–5 players.",
  "exports": {
    "./engine": "./server/tanks.js",
    "./package": "./dist/game.rmg.json",
    "./public/*": "./public/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "retro-museum-host --package dist/game.rmg.json",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@manaty/retro-museum-sdk": "https://github.com/manaty/retro-museum-sdk/archive/65f499eccbbf2cd2f72f42e5edea8a4c62e2a0d0.tar.gz",
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
